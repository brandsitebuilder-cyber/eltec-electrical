<section id="contact" class="py-20 md:py-28 border-t border-border-subtle">
  <div class="wrap">
    <div class="grid md:grid-cols-2 gap-16">
      <div>
        <div class="section-label">Get In Touch</div>
        <h2 class="section-title">Let's Talk</h2>
        <p class="text-text-muted leading-relaxed mb-8">Need electrical work done? Call us or fill in the form and we'll get back to you.</p>

        <div class="space-y-6 mb-10">
          <a href="tel:0813917733" class="flex items-center gap-4 text-text-secondary hover:text-text transition-colors group">
            <div class="w-10 h-10 rounded-full bg-surface border border-border-subtle flex items-center justify-center group-hover:border-accent transition-colors">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 1h3l1 3-2 2a10 10 0 005 5l2-2 3 1v3a2 2 0 01-2 2A13 13 0 011 3a2 2 0 012-2z"/></svg>
            </div>
            <div><div class="text-xs text-text-muted">Phone</div><div class="text-sm font-medium">081 391 7733</div></div>
          </a>
          <a href="https://wa.me/27813917733" class="flex items-center gap-4 text-text-secondary hover:text-text transition-colors group">
            <div class="w-10 h-10 rounded-full bg-surface border border-border-subtle flex items-center justify-center group-hover:border-accent transition-colors">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </div>
            <div><div class="text-xs text-text-muted">WhatsApp</div><div class="text-sm font-medium">Message us</div></div>
          </a>
          <a href="mailto:info@eltec.co.za" class="flex items-center gap-4 text-text-secondary hover:text-text transition-colors group">
            <div class="w-10 h-10 rounded-full bg-surface border border-border-subtle flex items-center justify-center group-hover:border-accent transition-colors">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="14" height="10" rx="2"/><path d="M1 4l7 5 7-5"/></svg>
            </div>
            <div><div class="text-xs text-text-muted">Email</div><div class="text-sm font-medium">info@eltec.co.za</div></div>
          </a>
        </div>

        <div class="bg-surface border border-border-subtle p-6">
          <div class="flex items-center gap-2 mb-2"><span class="text-yellow-400 text-sm">★★★★★</span></div>
          <p class="text-sm text-text-muted mb-3">Happy with our work? Leave us a Google review — it helps other locals find a trusted electrician.</p>
          <a href="https://maps.app.goo.gl/G7tsSdTCZ2wAGj7ZA" target="_blank" rel="noopener" class="btn-ghost text-sm !py-2 !px-4">Write a Review →</a>
        </div>
      </div>

      <div>
        <form id="contact-form" data-quotehub-slug="eltec-electrical" data-quotehub-source="https://eltec-electrical.vercel.app/" class="space-y-4">
          <input type="hidden" name="client_slug" value="eltec-electrical" />
          <input type="hidden" name="source_url" value="https://eltec-electrical.vercel.app/" />
          <div><input type="text" name="customer_name" placeholder="Your name" required class="form-input" /></div>
          <div><input type="email" name="customer_email" placeholder="Email address" required class="form-input" /></div>
          <div><input type="tel" name="customer_phone" placeholder="Phone number" class="form-input" /></div>
          <div>
            <select name="service_type" class="form-input">
              <option value="">Service needed</option>
              <option value="commercial">Commercial Electrical</option>
              <option value="industrial">Industrial Electrical</option>
              <option value="residential">Residential Electrical</option>
              <option value="emergency">Emergency Repair</option>
              <option value="coc">COC Certificate</option>
              <option value="other">Other</option>
            </select>
          </div>
          <div>
            <select name="timeline" class="form-input">
              <option value="">Timeline</option>
              <option value="ASAP">ASAP</option>
              <option value="Within 1 month">Within 1 month</option>
              <option value="1-2 months">1–2 months</option>
              <option value="3+ months">3+ months</option>
              <option value="Just exploring">Just exploring</option>
            </select>
          </div>
          <div><textarea name="message" placeholder="Tell us about your project..." rows="4" class="form-input"></textarea></div>
          <button type="submit" class="btn-primary w-full justify-center">Send Message →</button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  document.getElementById('contact-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = e.target.querySelector('button[type="submit"]');
    const orig = btn.textContent;
    btn.textContent = 'Sending...';
    btn.disabled = true;
    try {
      const fd = new FormData(e.target);
      const res = await fetch('https://quotehub-theta.vercel.app/api/quote', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          client_slug: fd.get('client_slug') || 'eltec-electrical',
          customer_name: fd.get('customer_name'),
          customer_email: fd.get('customer_email'),
          customer_phone: fd.get('customer_phone'),
          service_type: fd.get('service_type'),
          timeline: fd.get('timeline'),
          message: fd.get('message'),
          source_url: fd.get('source_url') || 'https://eltec-electrical.vercel.app',
        }),
      });
      if (res.ok) {
        window.location.href = '?sent=true';
      } else {
        alert('Something went wrong. Please try again or call us.');
      }
    } catch {
      alert('Something went wrong. Please try again or call us.');
    } finally {
      btn.textContent = orig;
      btn.disabled = false;
    }
  });
</script>
